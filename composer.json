{
    "name": "flytachi/winter-cpool",
    "description": "Driver-agnostic connection pool for PHP — coroutine-safe under Swoole, single-connection fallback everywhere else.",
    "type": "library",
    "license": "MIT",
    "scripts": {
        "test": "phpunit",
        "test-detail": "phpunit --testdox",
        "cs-check": "phpcs .",
        "cs-fix": "phpcbf ."
    },
    "autoload": {
        "psr-4": {
            "Flytachi\\Winter\\CPool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flytachi\\Winter\\CPool\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "swoole/ide-helper": "^6.0",
        "phpunit/phpunit": "@stable",
        "squizlabs/php_codesniffer": "@stable"
    },
    "suggest": {
        "ext-swoole": "Required for coroutine-safe pooling; without it the pool degrades to a single shared connection"
    },
    "homepage": "https://winterframe.net",
    "support": {
        "issues": "https://github.com/flytachi/winter-cpool/issues",
        "source": "https://github.com/flytachi/winter-cpool",
        "docs": "https://winterframe.net/packages/cpool"
    },
    "keywords": [
        "connection-pool",
        "pool",
        "swoole",
        "coroutine",
        "php",
        "winter"
    ],
    "authors": [
        {
            "name": "Flytachi",
            "email": "jason.khan.x@gmail.com"
        }
    ]
}
